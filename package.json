{
  "name": "ncf-agent-interconnect",
  "version": "0.18.1",
  "private": true,
  "type": "module",
  "description": "A local message hub for AI agents, with MCP access and desktop client adapters.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "test": "npm run test:desktop",
    "check": "npm run typecheck && npm run format:check",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/clean-build.mjs && tsc -p tsconfig.build.json && vite build && node scripts/build-assets.mjs",
    "app": "npm run build && electron .",
    "test:desktop": "node --experimental-sqlite --import tsx --test --test-concurrency=1 test-desktop/*.test.ts",
    "test:ui": "node --experimental-sqlite scripts/test-desktop-ui.mjs",
    "build:release": "node scripts/build-release.mjs",
    "build:mac": "npm run build:release -- --mac",
    "build:win": "npm run build:release -- --win",
    "prepare:runtime": "node node_modules/electron/install.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@decimalturn/toml-patch": "3.3.2",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@mui/icons-material": "9.5.0",
    "@mui/material": "9.5.0",
    "fast-srp-hap": "2.0.4",
    "jsonc-parser": "3.3.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "selfsigned": "5.5.0",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.1.0",
    "electron-builder": "27.0.0-alpha.14",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "overrides": {
    "app-builder-lib": {
      "minimatch": "11.0.3"
    },
    "@electron/asar": {
      "glob": "14.0.3",
      "minimatch": "11.0.3"
    },
    "filelist": {
      "minimatch": "11.0.3"
    }
  },
  "main": "build/main/index.js",
  "productName": "NCF Agent Interconnect",
  "author": "no-colours-fabric",
  "license": "BSD-3-Clause",
  "homepage": "https://github.com/no-colours-fabric/ncf-agent-interconnect",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/no-colours-fabric/ncf-agent-interconnect.git"
  },
  "bugs": {
    "url": "https://github.com/no-colours-fabric/ncf-agent-interconnect/issues"
  },
  "keywords": [
    "mcp",
    "ai-agents",
    "electron",
    "typescript",
    "messaging"
  ]
}
